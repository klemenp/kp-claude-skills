#!/usr/bin/env bash
# Fake gh for the repo-code fixtures: serves $FAKE_ISSUES (a JSON array of REST issue
# objects) for the issue list, logs every call's argument vector (one line, %q-quoted) to
# $FAKE_LOG, and fails the read when FAKE_READ_FAIL=1.
set -euo pipefail

printf '%q ' "$@" >> "$FAKE_LOG"
echo >> "$FAKE_LOG"

case "$1 $2" in
  api\ repos/*/issues\?*)
    [ "${FAKE_READ_FAIL:-}" = 1 ] && { echo "HTTP 502: issues unavailable" >&2; exit 1; }
    printf '%s\n' "${FAKE_ISSUES:-[]}" ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
