#!/usr/bin/env python3
"""A stand-in for `gh`, answering only the calls audit-close-move.sh makes, from the
scenario file named by $FAKE_GH_SCENARIO: `issueState` (`<repo>#<n>` → `open`|`closed`,
default `open`) and `comments` (the decision's comment bodies). Each issue's node id is
`node-<repo>#<n>`. Every call is logged to $FAKE_CALL_LOG as `gh <args…>`."""
import json
import os
import sys

scenario = json.load(open(os.environ["FAKE_GH_SCENARIO"]))
args = sys.argv[1:]
with open(os.environ["FAKE_CALL_LOG"], "a") as log:
    log.write(" ".join(["gh", *args]) + "\n")

if args[:2] in (["label", "create"], ["issue", "close"]):
    sys.exit(0)
if args[:2] == ["api", "graphql"]:
    print(json.dumps({"data": {"addSubIssue": {"issue": {"number": 1}}}}))
    sys.exit(0)
path = next(arg for arg in args[1:] if arg.startswith("repos/"))
owner, name, kind, number, *rest = path.removeprefix("repos/").split("/")
ref = f"{owner}/{name}#{number}"
if rest == ["comments"]:
    if "-X" in args:
        print(json.dumps({"id": 1}))
    else:
        # --paginate prints one array per page; split the comments over two pages.
        bodies = [{"body": body} for body in scenario.get("comments", [])]
        print(json.dumps(bodies[:1]) + json.dumps(bodies[1:]))
elif not rest:
    print(json.dumps({"node_id": f"node-{ref}",
                      "state": scenario.get("issueState", {}).get(ref, "open")}))
else:
    sys.exit(f"fake gh: unexpected call {args!r}")
