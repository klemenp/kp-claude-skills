#!/usr/bin/env python3
"""A stand-in for `gh`, answering only the REST calls milestone-tag.sh makes, from the
scenario file named by $FAKE_GH_SCENARIO: `defaultBranch` per repo (default `main`),
`tags` (repo → SHA of an existing milestone tag), `failCreate` (repos whose ref create
fails). Each repo's HEAD is `head-<owner>-<repo>`. Every git/refs POST is logged to
$FAKE_GH_POST_LOG as `<repo> <ref> <sha>`."""
import json
import os
import sys

scenario = json.load(open(os.environ["FAKE_GH_SCENARIO"]))
args = sys.argv[1:]
fields = dict(args[i + 1].split("=", 1) for i, arg in enumerate(args) if arg == "-f")
path = next(arg for arg in args[1:] if arg.startswith("repos/"))
owner, name, *rest = path.removeprefix("repos/").split("/")
repo = f"{owner}/{name}"
branch = scenario.get("defaultBranch", {}).get(repo, "main")

if "-X" in args:
    if rest != ["git", "refs"]:
        sys.exit(f"fake gh: unexpected POST {path}")
    if repo in scenario.get("failCreate", []):
        sys.exit("gh: Reference update failed (HTTP 422)")
    with open(os.environ["FAKE_GH_POST_LOG"], "a") as log:
        log.write(f"{repo} {fields['ref']} {fields['sha']}\n")
    print(json.dumps({"ref": fields["ref"], "object": {"sha": fields["sha"]}}))
elif not rest:
    print(json.dumps({"default_branch": branch}))
elif rest == ["commits", branch]:
    print(json.dumps({"sha": f"head-{owner}-{name}"}))
elif rest[:3] == ["git", "ref", "tags"]:
    sha = scenario.get("tags", {}).get(repo)
    if sha is None:
        sys.exit("gh: Not Found (HTTP 404)")
    print(json.dumps({"ref": "refs/" + "/".join(rest[2:]), "object": {"sha": sha}}))
else:
    sys.exit(f"fake gh: unexpected call {args!r}")
