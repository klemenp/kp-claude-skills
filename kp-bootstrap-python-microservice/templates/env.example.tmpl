# {{PROJECT_NAME}} configuration. Copy to .env and adjust per environment.

# Application identity / runtime
APP_NAME={{PROJECT_NAME}}
ENV=development
HOST=0.0.0.0
PORT=8000

# Persistence
DATA_FILE=data/{{PROJECT_NAME}}.json

# Basic auth credentials for protected endpoints
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=changeme

# In-memory cache
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1024

# Logging
LOG_LEVEL=INFO
