#!/usr/bin/env bash
# A stand-in for `gh`, answering only the `gh pr create` compact-apply.sh runs: appends its
# argument vector, one line, to $FAKE_GH_LOG and prints a fixed PR URL, or exits 1 when
# FAKE_GH_FAIL=1.
set -euo pipefail
printf '%s\n' "$*" >>"${FAKE_GH_LOG:-/dev/null}"
if [ "${FAKE_GH_FAIL:-0}" = 1 ]; then
  echo "fake gh: pr create failed" >&2
  exit 1
fi
echo "https://github.com/o/r/pull/1"
